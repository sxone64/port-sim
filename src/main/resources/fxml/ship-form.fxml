<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
    <Label maxWidth="Infinity" text="Ship type" />
    <HBox alignment="CENTER">
        <ToggleButton fx:id="commercialToggleBtn" selected="true" text="Commercial">
            <toggleGroup>
                <ToggleGroup fx:id="shipTypeGroup" />
            </toggleGroup>
        </ToggleButton>
        <ToggleButton fx:id="stateToggleBtn" text="State service" toggleGroup="$shipTypeGroup" />
    </HBox>
    <ComboBox fx:id="shipTypeCombo" promptText="Select ship type" />
    <Separator>
        <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </VBox.margin>
    </Separator>
    <Label maxWidth="Infinity" text="Common fields" />
    <VBox>
        <Label text="Ship name" />
        <TextField fx:id="nameField" />
    </VBox>
    <HBox spacing="10.0">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="IMO number" />
            <TextField fx:id="imoField" />
        </VBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Registration number" />
            <TextField fx:id="regNumberField" />
        </VBox>
    </HBox>
    <VBox>
        <Label text="Engine number" />
        <TextField fx:id="engineNumberField" />
    </VBox>
    <VBox>
        <Label text="Photo" />
        <HBox spacing="10.0">
            <TextField fx:id="photoField" editable="false" focusTraversable="false" HBox.hgrow="ALWAYS" />
            <Button text="Browse" />
        </HBox>
    </VBox>
    <Separator>
        <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </VBox.margin>
    </Separator>
    <Label fx:id="shipTypeLabel" maxWidth="Infinity" />
    <VBox fx:id="specificFieldsVBox" spacing="10" />
    <Separator>
        <VBox.margin>
            <Insets bottom="10.0" top="10.0" />
        </VBox.margin>
    </Separator>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="cancelBtn" text="Cancel" />
        <Button fx:id="confirmBtn" />
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import portsim.ui.node.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="portsim.ui.controller.SimulationController">
   <top>
       <HBox alignment="CENTER" spacing="10.0">
           <Label text="Progress" />
           <ProgressBar fx:id="progressBar" maxWidth="Infinity"
                        prefHeight="10.0" progress="0.0" HBox.hgrow="ALWAYS" />
           <Button fx:id="addShipBtn" text="Add ship" />
       </HBox>
   </top>
    <center>
        <GridPane hgap="10.0">
            <BorderPane.margin>
                <Insets top="10.0" />
            </BorderPane.margin>
            <columnConstraints>
                <ColumnConstraints percentWidth="60.0" />
                <ColumnConstraints percentWidth="40.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="100.0" />
            </rowConstraints>
            <SimulationPane fx:id="simulationPane" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <FlowPane alignment="CENTER_LEFT" hgap="10.0" vgap="10.0">
                    <VBox alignment="CENTER_LEFT" minWidth="-Infinity"
                          prefWidth="100.0" style="-fx-border-color: gray;">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Ships entered:" />
                        <Label fx:id="shipsEnteredLabel">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </VBox>
                    <VBox alignment="CENTER_LEFT" minWidth="-Infinity"
                          prefWidth="100.0" style="-fx-border-color: gray;">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Ships left:" />
                        <Label fx:id="shipsLeftLabel">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </VBox>
                    <VBox alignment="CENTER_LEFT" minWidth="-Infinity"
                          prefWidth="100.0" style="-fx-border-color: gray;">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <Label text="Incidents:" />
                        <Label fx:id="incidentsLabel">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                    </VBox>
                </FlowPane>
                <Label text="Events log" />
                <Separator />
                <EventsLogNode fx:id="eventsLogNode" maxMessages="10" style="-fx-border-color: grey;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </EventsLogNode>
            </VBox>
        </GridPane>
    </center>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <bottom>
        <HBox alignment="BOTTOM_RIGHT" spacing="5.0" BorderPane.alignment="BOTTOM_RIGHT">
            <VBox alignment="BOTTOM_CENTER">
                <Label text="Min ships per terminal" />
                <HBox alignment="CENTER" spacing="5">
                    <Slider fx:id="minShipsSlider" prefWidth="200.0"
                            blockIncrement="1" />
                    <TextField fx:id="minShipsField" editable="false" prefWidth="40.0" />
                </HBox>
            <HBox.margin>
               <Insets right="20.0" />
            </HBox.margin>
            </VBox>
            <Button fx:id="playBtn" onAction="#onPlayAction" defaultButton="true" text="Play" />
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
        </HBox>
   </bottom>
</BorderPane>
